# Cloudflare Pages: заголовки безопасности и кэширование.
# Файл читается автоматически при деплое (HOSTING.md).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # CSP: только свой код + Google Identity + Turnstile + сети рекламы (РСЯ/AdSense).
  # Если реклама выключена (ADS.mode = 'off'), строки с ads-доменами можно удалить.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' https://plausible.io https://accounts.google.com https://challenges.cloudflare.com https://yandex.ru https://an.yandex.ru https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com; connect-src 'self' https://accounts.google.com https://challenges.cloudflare.com https://mc.yandex.ru https://plausible.io https://www.google-analytics.com; frame-src 'self' https://accounts.google.com https://challenges.cloudflare.com https://yandex.ru https://an.yandex.ru https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; font-src 'self' data:; manifest-src 'self'

# Исходные имена CSS/JS не содержат fingerprint: короткий кэш обязан
# пропускать новые релизы сразу (долгий immutable здесь залипает на edge).
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# В будущем fingerprint-ассеты можно вынести в отдельное правило:
# /assets/*.[a-f0-9]*
#   Cache-Control: public, max-age=31536000, immutable

# HTML и манифест — всегда свежие
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Service worker — всегда свежий, иначе обновления не долетают
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# API-прокси (если API разворачивается маршрутом на том же домене)
/api/*
  Cache-Control: no-store
