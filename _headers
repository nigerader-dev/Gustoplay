# Cloudflare Pages: заголовки безопасности и кэширование.
# Файл читается автоматически при деплое (HOSTING.md).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  # CSP: только свой код + Google Identity + Turnstile + Метрика + сети рекламы (РСЯ: домены Яндекса;
  # AdSense для Беларуси недоступен, его домены оставлены на случай смены страны владельца).
  # Если реклама выключена (ADS.mode = 'off'), строки с ads-доменами можно удалить.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://yastatic.net https://accounts.google.com; script-src 'self' https://plausible.io https://static.cloudflareinsights.com https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://yandex.ru https://an.yandex.ru https://*.yandex.ru https://*.yandex.net https://accounts.google.com https://challenges.cloudflare.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com; connect-src 'self' https://accounts.google.com https://challenges.cloudflare.com https://cloudflareinsights.com https://mc.yandex.ru https://mc.yandex.com https://plausible.io https://yandex.ru https://an.yandex.ru https://*.yandex.ru https://*.yandex.net https://yastatic.net https://www.google-analytics.com; frame-src 'self' https://accounts.google.com https://challenges.cloudflare.com https://yandex.ru https://an.yandex.ru https://*.yandex.ru https://*.yandex.net https://yastatic.net https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; font-src 'self' data: https://yastatic.net; manifest-src 'self'

# Исходные имена CSS/JS не содержат fingerprint: короткий кэш обязан
# пропускать новые релизы сразу (долгий immutable здесь залипает на edge).
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Версионированные ассеты (сборка кладёт JS/CSS в /assets/<хэш>/…, у каждого
# релиза свой хэш) — содержимое по адресу никогда не меняется, кэшируем на год
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML и манифест — всегда свежие
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Service worker — всегда свежий, иначе обновления не долетают
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# API-прокси (если API разворачивается маршрутом на том же домене)
/api/*
  Cache-Control: no-store
